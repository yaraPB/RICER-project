// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  cin        String   @unique
  phone      String
  password   String
  role       Role
  department String?
  position   String?
  reports    Report[]
  refreshTokens RefreshToken[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  CIVILIAN
  OFFICIAL
}

model RefreshToken {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id])
  jti          String   @unique
  tokenHash    String   @unique
  scopes       String[]
  expiresAt    DateTime
  rotatedAt    DateTime?
  revokedAt    DateTime?
  replacedByJti String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Report {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id])
  latitude    Float
  longitude   Float
  description String
  images      String[]
  status      Status    @default(PENDING)
  cause       String?
  incidentId  String?   @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([incidentId])
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum IncidentStatus {
  PENDING
  VIGILANCE
  ALERTE
  INTERVENTION
  MAITRISE
  ETEINT
  COMPLETED
  IN_PROGRESS
}

model Incident {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  location    Json?
  cause       String
  severity    Int
  status      IncidentStatus @default(VIGILANCE)
  description String?
  reportId    String?        @db.ObjectId
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([reportId])
}

model Equipment {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  category        String
  name            String
  quantity        Int
  condition       String
  lastMaintenance DateTime?
  location        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([condition])
  @@index([lastMaintenance])
}

model RetardantProduct {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  productName     String
  acquisitionDate DateTime
  storageLocation String
  quantity        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum InfrastructureType {
  WATCHTOWER
  WATER_POINT
  FIREBREAK
  STATION
}

model Infrastructure {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  type        InfrastructureType
  name        String
  geometry    Json?
  status      String
  description String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([type])
}

enum ResourceType {
  TRUCK
  AIRCRAFT
  PERSONNEL
  EQUIPMENT
}

model Resource {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  type        ResourceType
  name        String
  location    Json?
  status      String
  assignedTo  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([status])
}

model RiskBasin {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  geometry    Json?
  riskLevel   Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([riskLevel])
}

model TruckDeployment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  truckId    String
  truckName  String
  latitude   Float
  longitude  Float
  status     String
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
