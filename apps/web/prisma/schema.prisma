// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  cin        String   @unique
  phone      String
  password   String
  role       Role
  department String?
  position   String?
  reports    Report[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  CIVILIAN
  OFFICIAL
}

model Report {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  latitude    Float
  longitude   Float
  description String
  images      String[]
  status      Status   @default(PENDING)
  cause       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Incident {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  latitude    Float
  longitude   Float
  cause       String
  severity    Int
  status      Status   @default(PENDING)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Equipment {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  category        String
  name            String
  quantity        Int
  condition       String
  lastMaintenance DateTime?
  location        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model RetardantProduct {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  productName     String
  acquisitionDate DateTime
  storageLocation String
  quantity        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Infrastructure {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String
  name        String
  latitude    Float?
  longitude   Float?
  status      String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TruckDeployment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  truckId    String
  truckName  String
  latitude   Float
  longitude  Float
  status     String
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
