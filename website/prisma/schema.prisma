generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String?  @unique
  phone       String   @unique
  fullName    String
  cin         String   @unique
  password    String
  role        UserRole @default(CIVILIAN)
  department  String?
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  reports     Report[]
  
  @@map("users")
}

enum UserRole {
  CIVILIAN
  FIREFIGHTER
  ADMIN
}

model Report {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  userId        String       @db.ObjectId
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  latitude      Float?
  longitude     Float?
  locationText  String?
  datetime      DateTime
  comment       String?
  files         String[]
  status        ReportStatus @default(PENDING)
  severity      Severity     @default(UNKNOWN)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@map("reports")
}

enum ReportStatus {
  PENDING
  VERIFIED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  UNKNOWN
}

model Equipment {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nameAr      String
  category    String
  categoryAr  String
  quantity    Int     @default(0)
  isInspected Boolean @default(false)
  lastUpdated DateTime @updatedAt
  
  @@map("equipment")
}

model Infrastructure {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  nameAr         String
  type           String
  typeAr         String
  condition      Condition @default(MILD)
  lastInspection DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@map("infrastructure")
}

enum Condition {
  GOOD
  MILD
  BAD
}
